# LEGACY, kept only because docker-compose.staging.yml's backend-staging names it
# as env_file: delete it together with that service. The KG staging runbook
# (docs/staging_promotion.md) and the scripts that sourced it were removed in the R2
# cleanup; both remain in git history (commit 1618cbd).
#
# Staging target for KG rebuilds.
# Source it in the shell that runs the pipeline scripts:
#
#   source scripts/tools/staging.env
#
# Why a file rather than ad-hoc exports: every script calls load_dotenv()
# without override, so any variable not exported here silently falls back to
# .env's production value (Step 3 truncates PG tables, Step 5 clears the graph,
# Step 8 --recreate drops the entity collection). With KG_TARGET=staging the
# write scripts check, before connecting (scripts/kg_target.py), that NEO4J_URI,
# POSTGRES_DB and QDRANT_ENTITY_COLLECTION are set and not production; this file
# sets all of them in one step.
#
# It is also backend-staging's env_file (docker-compose.staging.yml), so the
# staging backend and the scripts read one set of values. Keep to what both
# bash and compose's env_file parser accept: comments and `export KEY=value`
# lines, with ${VAR:-default} at most. scripts/tests/test_kg_target.py checks this.
#
# Each batch bumps QDRANT_ENTITY_COLLECTION (bible_entities_vN) here, not in the
# shell, so that backend-staging follows.
#
# In a shell that sourced this file:
#   - start neo4j-staging (docker compose -f docker-compose.yml
#     -f docker-compose.staging.yml up -d neo4j-staging), so its NEO4J_AUTH is
#     built from the same credentials the scripts get below;
#   - never `docker compose up` a production service: docker-compose.yml
#     interpolates ${POSTGRES_DB} into the production postgres service, and
#     compose would recreate that container. Naming neo4j-staging or
#     backend-staging is safe.
#
# Deliberately not set: QDRANT_COLLECTION and QDRANT_HYBRID_COLLECTION. The
# passage collections are shared with production, so Step 4/4.1 refuse to run
# under KG_TARGET=staging.

export KG_TARGET=staging

# neo4j-staging publishes bolt on 7688 (production: 7687).
export NEO4J_URI=bolt://localhost:7688
# Same expressions as neo4j-staging's NEO4J_AUTH: credentials already exported
# in the shell are kept, otherwise compose's defaults apply.
export NEO4J_USER=${NEO4J_USER:-neo4j}
export NEO4J_PASSWORD=${NEO4J_PASSWORD:-neo4j_password}

# Same PG container (bible_rag_postgres), separate database.
export POSTGRES_DB=bible_rag_staging

# Same Qdrant, separate entity collection.
export QDRANT_ENTITY_COLLECTION=bible_entities_v2
