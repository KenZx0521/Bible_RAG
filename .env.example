# Entity Extraction Configuration

# ============================================
# LLM Configuration
# ============================================

# LLM Provider: "claude" or "gemini" or "openai"
LLM_PROVIDER=claude

# Claude API Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5

# Alternative: Gemini API Configuration
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Alternative: OpenAI API Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ============================================
# LLM Request Configuration
# ============================================

# Maximum tokens for LLM response
LLM_MAX_TOKENS=1024

# Temperature (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Rate limiting (seconds between requests)
LLM_RATE_LIMIT_DELAY=1.0

# Maximum retry attempts
LLM_MAX_RETRIES=3

# Retry delay (seconds)
LLM_RETRY_DELAY=5.0

# ============================================
# CKIP Configuration
# ============================================

# Use GPU for CKIP models (true/false)
CKIP_USE_GPU=false

# ============================================
# Extraction Configuration
# ============================================

# Batch size for processing
BATCH_SIZE=5

# Enable verbose logging (true/false)
VERBOSE=false

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bible_rag
POSTGRES_USER=bible
POSTGRES_PASSWORD=bible_password

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Docker Deployment
# ============================================
# Backend port (default: 8000)
# BACKEND_PORT=8000
#
# NOTE: When running with docker compose, the following hosts are
# automatically overridden in docker-compose.yml:
#   POSTGRES_HOST -> postgres
#   QDRANT_HOST   -> qdrant
#   NEO4J_URI     -> bolt://neo4j:7687
#   OLLAMA_BASE_URL -> http://host.docker.internal:11434
# You do NOT need to change them here.
