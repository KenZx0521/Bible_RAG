# Entity Extraction Configuration

# ============================================
# LLM Configuration
# ============================================

# Backend RAG LLM Provider (用於回答生成和意圖分類)
# ollama | claude | openai | gemini
# 與現行 .env 對齊(2026-07):本地 Ollama 跑 gemma4;改用 claude 需填 ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# NOTE: Evaluation 專屬參數(EVAL_*、BACKEND_URL、TOP_K 等)已移至 evaluation/.env
#       (範本見 evaluation/.env.example)

# Claude API Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini API Configuration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# LLM Request Configuration
# ============================================

# Maximum tokens for LLM response
LLM_MAX_TOKENS=10000

# Temperature (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Rate limiting (seconds between requests)
LLM_RATE_LIMIT_DELAY=2.0

# Maximum retry attempts
LLM_MAX_RETRIES=3

# Retry delay (seconds)
LLM_RETRY_DELAY=5.0

# ============================================
# Hybrid Search Configuration
# ============================================

# Enable hybrid search (true/false)
# backend code 預設 false;正式部署 run-of-record 為 true,勿移除此 key
HYBRID_SEARCH_ENABLED=true

# Qdrant hybrid collection name
QDRANT_HYBRID_COLLECTION=bible_embeddings_hybrid

# Path to BM25 vocabulary file
BM25_VOCABULARY_PATH=output/bm25_vocabulary.json

# Number of candidates to prefetch from each modality
HYBRID_PREFETCH_LIMIT=50

# Fusion method: "rrf" (Reciprocal Rank Fusion)
HYBRID_FUSION_METHOD=rrf

# ============================================
# Graph Retrieval Configuration
# ============================================
# Enable graph-based retrieval (Neo4j).
# When false, R3/R4/R5/R6 skip graph_retriever + cross_ref_retriever,
# falling back to semantic + SQL supplement only.
# Can also be overridden per-request via the `use_graph` payload field
# (evaluation CLI: `--graph / --no-graph`).
RAG_USE_GRAPH=true

# Cross-reference 2-hop expansion. When true, R3/R4/R5/R6 traverse
# CROSS_REFERENCES up to RAG_CROSS_REF_MAX_HOPS steps from the highest-weight
# pre-rerank seeds, surfacing neighbouring pericopes along the 916 hand-curated
# cross-book edges. Set to false to fall back to 1-hop legacy behaviour.
RAG_USE_CROSS_REF_EXPAND=true
# Hop budget for the expansion (1-4). 2 = activate the curated cross-book edges
# without polluting candidate pool with weakly-related second-degree neighbours.
RAG_CROSS_REF_MAX_HOPS=2
# Number of top-weighted candidates used as expansion seeds.
RAG_CROSS_REF_TOP_SEEDS=5
# Maximum neighbours returned by the expansion per route. Dropped 30->10
# (2026-07-06): post-TSK the 1-hop pool is ~180/seed and 30 topical
# neighbours flooded the rerank pool, displacing narrative-correct
# pericopes on EVENT questions.
RAG_CROSS_REF_EXPAND_LIMIT=10

# Entity-Path retriever — walks Entity-Entity edges (FATHER_OF, RULED, ...)
# created by scripts/relation_extraction/extract_relations.py. Provides
# multi-hop fact-level reasoning. No-op until Entity-Entity edges exist.
RAG_USE_ENTITY_PATH=true
RAG_ENTITY_PATH_MAX_HOPS=2
RAG_ENTITY_PATH_LIMIT=15
QDRANT_ENTITY_COLLECTION=bible_entities

# Entity-Query retriever (supplement-only across R3/R4/R5/R6) — BGE-M3 query →
# bible_entities vector match → Neo4j MENTIONS pericopes. Adds candidates that
# semantic embedding misses (e.g. "王國分裂" → 列王紀上12 via Event entity
# 「北方的支派反叛」). Supplement-only weight 0.6 stays below semantic 0.7 so
# it never displaces a high-scoring semantic chunk from the pre-rerank pool.
RAG_USE_ENTITY_QUERY=true
RAG_ENTITY_QUERY_TOP_K=8
RAG_ENTITY_QUERY_SCORE_THRESHOLD=0.4
RAG_ENTITY_QUERY_HUB_THRESHOLD=50
RAG_ENTITY_QUERY_PERICOPES_PER_ENTITY_NORMAL=5
RAG_ENTITY_QUERY_PERICOPES_PER_ENTITY_HUB=3
RAG_ENTITY_QUERY_SUPPLEMENT_CAP=5

# Rank fusion (2026-07-06, P0-eval fix #3): final ordering blends the BGE
# reranker score with the retrieval-strategy prior:
#   fused = (1 - alpha) * rerank_score + alpha * strategy_weight
# Two independent eval rounds (2026-05 EQ displacement, 2026-07 TSK topical
# noise) showed pure rerank_score ordering lets literal surface matches erase
# graph signals. alpha=0 = legacy pure-reranker ordering.
RAG_RANK_FUSION_ENABLED=true
RAG_RANK_FUSION_ALPHA=0.3

# ============================================
# CKIP Configuration
# ============================================

# Use GPU for CKIP models (true/false)
CKIP_USE_GPU=false

# ============================================
# Extraction Configuration
# ============================================

# Batch size for processing
BATCH_SIZE=5

# Enable verbose logging (true/false)
VERBOSE=false

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bible_rag
POSTGRES_USER=bible
POSTGRES_PASSWORD=bible_password

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
# 與現行 .env 對齊(2026-07);code fallback 是 gemma3:4b(backend/config.py)
OLLAMA_MODEL=gemma4:e4b-it-q8_0

# ============================================
# Entity Extraction (Grounded Pipeline) Configuration
# ============================================
# Provider for Phase 4 LLM classifier: ollama | claude | gemini | openai
ENTITY_EXTRACT_LLM_PROVIDER=ollama
ENTITY_EXTRACT_OLLAMA_BASE_URL=http://localhost:11434
# 與現行 .env 對齊(2026-07);code fallback 是 gemma3:4b,漏設會用小一個量級的模型抽實體
ENTITY_EXTRACT_OLLAMA_MODEL=gemma4:31b-it-q8_0
ENTITY_EXTRACT_CLAUDE_MODEL=claude-3-5-haiku-20241022
ENTITY_EXTRACT_OPENAI_MODEL=gpt-4o-mini
ENTITY_EXTRACT_GEMINI_MODEL=gemini-1.5-flash
ENTITY_EXTRACT_MAX_TOKENS=2048
ENTITY_EXTRACT_TEMPERATURE=0.1
ENTITY_EXTRACT_RATE_LIMIT_DELAY=0.5
# Phase 4 Ollama num_ctx(code fallback 同為 32768,scripts/entity_extraction/config.py)
ENTITY_EXTRACT_NUM_CTX=32768
# Phase 2: 最低頻率門檻 (CKIP POS 候選需出現至少 N 次)
ENTITY_EXTRACT_MIN_FREQ=3
# Phase 3: 規則分類信心門檻 (低於此值的送 Phase 4 LLM)
ENTITY_EXTRACT_RULE_CONFIDENCE=0.8

# ============================================
# Relation Extraction (Grounded Pipeline) Configuration
# ============================================
# Provider: ollama | claude | openai
RE_LLM_PROVIDER=ollama
RE_OLLAMA_BASE_URL=http://localhost:11434
RE_OLLAMA_MODEL=gemma4:31b-it-q8_0
RE_CLAUDE_MODEL=claude-haiku-4-5
RE_OPENAI_MODEL=gpt-4o-mini
# JSON answer for batch=8 closed-set RE typically takes ~500 tokens. Bumped
# to 8192 to give wide headroom — gemma4:*-it can occasionally copy long
# evidence spans verbatim, and Ollama's num_predict is a hard cap that will
# truncate JSON mid-string if exceeded (causing parse failures even with
# format=json grammar-constrained decoding).
RE_MAX_TOKENS=8192
RE_TEMPERATURE=0.1
RE_NUM_CTX=16384
RE_RATE_LIMIT_DELAY=0.0
RE_MAX_RETRIES=3
RE_RETRY_DELAY=5.0
# Pairs per LLM prompt batch.
RE_BATCH_SIZE=8

# Pipeline knobs (paths default to repo-relative when unset)
# RE_SCHEMA_PATH=config/relations/biblical_relations.yaml
# RE_PRIORS_PATH=config/relations/biblical_priors.yaml
# RE_OUTPUT_PATH=output/relations.jsonl
# RE_CHECKPOINT_PATH=output/relations_checkpoint.jsonl
# RE_UNCLASSIFIED_PATH=output/relations_unclassified.jsonl
RE_GROUNDING_WINDOW=1
RE_MIN_PAIR_FREQ=1
RE_MAX_PAIRS_PER_PERICOPE=80
# Rule classifier confidence floor; below this, escalate to LLM.
RE_RULE_CONFIDENCE_FLOOR=0.85
RE_SKIP_SELF_LOOPS=true

# ============================================
# Entity Description Generation (Step 7) Configuration
# ============================================
# desc_generator.py 為 description 空白的 Person/Place/Group 產生 ≤80 字描述並寫回 Neo4j。
# 與現行 .env 對齊(2026-07);code fallback 是 gemma4:e4b-it-q8_0(文檔 Step 7 原始 run 所用)。
DESC_OLLAMA_MODEL=gemma4:26b-a4b-it-q8_0
# gemma4 *-it 是 reasoning 模型,回 JSON 前會先吐 ~800-900 個隱藏 thinking token;
# num_predict(code fallback 2048)沒清過該門檻時 content 會靜默截斷成 ""(done_reason=length)。
DESC_NUM_CTX=8192
DESC_NUM_PREDICT=8192

# ============================================
# Docker Deployment
# ============================================
# Backend port (default: 8000)
# BACKEND_PORT=8000
#
# NOTE: When running with docker compose, the following hosts are
# automatically overridden in docker-compose.yml:
#   POSTGRES_HOST -> postgres
#   QDRANT_HOST   -> qdrant
#   NEO4J_URI     -> bolt://neo4j:7687
#   OLLAMA_BASE_URL -> http://host.docker.internal:11434
# You do NOT need to change them here.
