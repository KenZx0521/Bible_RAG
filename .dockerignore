# Every virtualenv (scripts/.venv alone is 4.9 GB) and every Python/pytest cache:
# patterns without **/ match only the context root, not backend/ or packages/.
**/.venv
**/.pytest_cache
**/__pycache__
**/*.py[cod]

# Data files
output/
bible_pdf/
bible_md/
docs/

# Git
.git/
.gitignore

# IDE / tools
.claude/
.agents/
.vscode/
.idea/

# Environment (loaded via docker-compose env_file)
.env

# Misc
*.md
