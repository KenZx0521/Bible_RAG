# ============================================
# Evaluation-specific Configuration
# ============================================
# 只放 evaluation 專屬參數。共用基礎設施(API keys、PostgreSQL、
# OLLAMA_BASE_URL、LLM_MAX_TOKENS)仍讀專案根目錄 .env。
# 同名變數以本檔為準(evaluation/src/config.py 後載入本檔)。
#
# 使用方式:cp .env.example .env 後依需求調整。

# Evaluation LLM Provider (用於 LLM-as-Judge 評估)
# claude | openai | gemini | ollama
EVAL_LLM_PROVIDER=ollama

# Evaluation LLM Models (獨立於 Backend 的 LLM_PROVIDER/OLLAMA_MODEL)
EVAL_CLAUDE_MODEL=claude-haiku-4-5
EVAL_OPENAI_MODEL=gpt-4o-mini
EVAL_GEMINI_MODEL=gemini-2.0-flash
# 與現行 .env 對齊(2026-07);code fallback 是 gemma3:4b(evaluation/src/config.py)
EVAL_OLLAMA_MODEL=gemma4:26b-a4b-it-q8_0

# ============================================
# Evaluation Run Settings
# ============================================

# Backend RAG API endpoint
BACKEND_URL=http://localhost:8000

# Retrieval metrics @k / rag_client default top_k
TOP_K=5

# Delay between RAG API requests during collection (seconds)
REQUEST_DELAY=1.5

# ============================================
# RAGAS RunConfig (API providers only; ollama 走自己的序列化路徑)
# ============================================
# workers=16 saturates Anthropic rate limits → backoff retries blow the
# 180s job timeout (observed 27% TimeoutError); 4 workers stays under.
EVAL_RAGAS_WORKERS=4
EVAL_RAGAS_TIMEOUT=600
