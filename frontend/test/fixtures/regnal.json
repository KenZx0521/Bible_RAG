  {
   "id": "ck:2ch.13.1~2ch.13.11",
   "book": "歷代志下",
   "chapter": 13,
   "title": "亞比雅與耶羅波安爭戰",
   "verse_range": "1-11",
   "score": 0.7304157090187073,
   "strategy": "hybrid_hybrid",
