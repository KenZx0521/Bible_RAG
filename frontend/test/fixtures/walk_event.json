  {
   "id": "ps:act.15.1",
   "book": "使徒行傳",
   "chapter": 15,
   "title": "耶路撒冷會議",
   "verse_range": "1-21",
   "score": 0.6203903973102569,
   "strategy": "sql_supplement",
   "rerank_score": 0.6719862818717957,
   "found_by": [
